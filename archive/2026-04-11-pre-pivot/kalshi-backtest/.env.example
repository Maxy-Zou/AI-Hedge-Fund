# Kalshi API credentials
# Get API key ID from: https://kalshi.com/account/api-keys
KALSHI_BACKTEST_API_KEY_ID=your-api-key-id-here
# Path to your RSA private key PEM file
KALSHI_BACKTEST_PRIVATE_KEY_PATH=/path/to/your/private-key.pem

# API settings
# Use demo URL for development; production URL for live data
KALSHI_BACKTEST_API_BASE_URL=https://demo-api.kalshi.co/trade-api/v2
# Production: https://api.elections.kalshi.com/trade-api/v2

# Storage
KALSHI_BACKTEST_DB_PATH=kalshi_backtest.duckdb

# Ingestion settings
KALSHI_BACKTEST_RATE_LIMIT_RPM=60

# Required only when using --strategy insider-tracker
# KALSHI_TRACKER_DATABASE_URL=postgresql://user:pass@localhost:5432/kalshi_tracker
