# =============================================================================
# AI Hedge Fund -- Environment Configuration
# Copy to .env and fill in values.
# =============================================================================

# PostgreSQL connection (Docker Compose default -- change for remote DB)
DATABASE_URL=postgresql+psycopg://hedge:hedge@localhost:5432/ai_hedge_fund

# Anthropic (Claude models -- required for agent execution)
ANTHROPIC_API_KEY=

# SEC EDGAR (required -- must be "CompanyName email@example.com" format)
EDGAR_IDENTITY=

# Data sources -- free tier (get keys at each provider's site)
FINNHUB_API_KEY=
FMP_API_KEY=
FRED_API_KEY=

# Data sources -- paid (add when budget allows)
# POLYGON_API_KEY=
# THETADATA_API_KEY=

# Observability -- Langfuse (self-hosted or cloud)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Token budget overrides (defaults in config.py)
# EXTRACTION_TOKEN_LIMIT=22000
# ANALYSIS_TOKEN_LIMIT=58000
# REASONING_TOKEN_LIMIT=116000
# PIPELINE_TOTAL_TOKEN_LIMIT=500000

# Logging
LOG_LEVEL=INFO

# Alpaca paper trading (Phase 10 -- paper only; the code refuses a non-paper host)
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET=
ALPACA_PAPER_HOST=https://paper-api.alpaca.markets
